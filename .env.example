# OpenUI TUI Maker & Studio — Environment Variable Configuration
# Copy to `.env` (gitignored) or export in your shell.

# LiteLLM Proxy endpoint (or OpenAI-compatible gateway URL)
OPENUI_LITELLM_URL="http://localhost:4000"

# LiteLLM Virtual Key / API Key
OPENUI_LITELLM_API_KEY="sk-your-litellm-virtual-key"

# Default Gemini model (`gemini-3.8-flash`, `gemini-4-argon`, `gemini-3.1-pro`, `gemini-2.5-flash-lite`, etc.)
OPENUI_DEFAULT_MODEL="gemini-3.8-flash"

# TypeSafe Jev SystemOne router model (`/v1/systemone`)
OPENUI_JEV_MODEL="typesafe/jev-latest"

# SpendGuard hard budget cap in USD
OPENUI_BUDGET_LIMIT_USD="1.00"

# Optional override for JSONL telemetry output path
# OPENUI_TELEMETRY_JSONL="priv/telemetry/events.jsonl"
